<p style="color: green"><%= notice %></p>

<%= render @game %>

<div>
  <%= link_to "Edit this game", edit_game_path(@game) %> |
  <%= link_to "Back to games", games_path %>

  <%= button_to "Destroy this game", @game, method: :delete, data: { turbo_confirm: "Are you sure you want to delete this game?" } %>
</div>

<div class="game">
  <h3>Game status <button type="button" id="status_toggle" aria-controls="status_output" aria-expanded="false" aria-label="Show game status">▶</button></h3>
  <textarea id="status_output" style="width: 500px; height: 200px;" readonly hidden></textarea>
  <h3>Visible letters</h3>
  <div id="visible_letters" class="visible-letters">None</div>
  <div class="formed-words"></div>

  <div id="chat" data-room="game-<%= @game.id %>">
    <h3>Chat</h3>
    <textarea id="chat_output" style="width: 500px; height: 200px;" readonly></textarea>
    <input type="text" id="chat_input" style="width: 280px;">
    <button type="button" id="chat_say">Say</button>
    <button type="button" id="chat_dict">Dict</button>
    <button type="button" id="chat_flip">Flip</button>
    <button type="button" id="chat_nick">Nick</button>
    <button type="button" id="chat_help">Help</button>
  </div>
</div>

<% content_for :head do %>
<%= javascript_import_module_tag "game/chat" %>
<% end %>
